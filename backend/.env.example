# ==============================================================================
# TestForge QA Automation & AI Testing Platform Configuration
# ==============================================================================

PROJECT_NAME="TestForge - AI Software Testing & QA Automation Platform"
API_V1_STR="/api/v1"
ENVIRONMENT="development"
DEBUG=True

# Google Gemini API Key for AI Test Generation & Bug Analysis
GEMINI_API_KEY=""
GEMINI_MODEL="gemini-1.5-flash"

# Testing Runtime Settings
DEFAULT_TIMEOUT_SECONDS=15
MAX_CONCURRENT_TESTS=10
DEFAULT_BASE_URL="https://jsonplaceholder.typicode.com"

# Storage & Reports Directory
REPORTS_DIR="../../reports"
TEST_DATA_DIR="../../test_data"

# Server & Network Configuration
HOST="0.0.0.0"
PORT=8000
ALLOWED_ORIGINS="http://localhost:5173,http://localhost:3000,http://127.0.0.1:5173"
